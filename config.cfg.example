SERVER_PORT=0000
REDIS_PORT=0000
REDIS_HOST=localhost
POSTGRES_PORT=0000
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=password
POSTGRES_USER=user
POSTGRES_DATABASE=database

TMDB_TOKEN = token
TMDB_BASE_URL = https://api.themoviedb.org/3
TMDB_POSTER_PATH = https://image.tmdb.org/t/p
TMDB_RATE_LIMIT = 10
TMDB_TIMEOUT = 10s
ELASTIC_URL = http://localhost:9200
ELASTIC_USERNAME =
ELASTIC_PASSWORD =
ELASTIC_INDEX_PREFIX = lifelog
ELASTIC_READ_TIMEOUT = 5s
FILMS_SEARCH_CACHE_TTL = 30s

AUTH_PORT = 9092
AUTH_POSTGRES_DATABASE = lifelog_auth
AUTH_PRIVATE_KEY_PATH = ./secrets/auth_signing_key.pem
AUTH_ISSUER = lifelog-auth
AUTH_AUDIENCE = lifelog
AUTH_ACCESS_TTL = 15m
AUTH_REFRESH_TTL = 720h
AUTH_INTERNAL_TOKEN = internal-token-for-bot
AUTH_BOT_USERNAME = lifelog_bot
AUTH_MERGE_TARGETS = http://trips:8080/api
AUTH_JWKS_URL = http://auth:9092/.well-known/jwks.json
AUTH_JWKS_CACHE_TTL = 1h

AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=
AUTH_MAIL_CAPTURE=false

NOTIFY_PORT = 9095
NOTIFY_POSTGRES_DATABASE = lifelog_notify
NOTIFY_FCM_CREDENTIALS_FILE = ./secrets/firebase-admin.json
NOTIFY_FCM_ENDPOINT = https://fcm.googleapis.com
NOTIFY_URL = http://localhost:9095
NOTIFY_VAPID_PUBLIC_KEY =
NOTIFY_VAPID_PRIVATE_KEY =
NOTIFY_VAPID_SUBJECT = mailto:admin@example.com
NOTIFY_ALLOW_TEST_ENDPOINTS = false
